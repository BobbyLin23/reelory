{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reelory-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "dev": { "port": 3058 },
  // KV cache for TMDB responses, keyed with per-endpoint TTLs.
  "kv_namespaces": [
    { "binding": "TMDB_CACHE", "id": "2870323fdfb14edaba9d8d18e30a5524" },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reelory",
      "database_id": "75d95b60-cc8e-4161-b3e8-d38e40116b72",
      // drizzle-kit writes one folder per migration; point Wrangler at the SQL inside.
      "migrations_dir": "../../packages/db/src/migrations",
      "migrations_pattern": "../../packages/db/src/migrations/*/migration.sql",
    },
  ],
}
